generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  MANAGER
  SERVICE_EMPLOYEE
  KITCHEN_EMPLOYEE
  BILLING_EMPLOYEE
}

enum BranchStatus {
  OPENING_SOON
  OPEN
  CLOSED
  TEMPORARILY_CLOSED
  PERMANENTLY_CLOSED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  OUT_OF_SERVICE
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum OrderType {
  STAFF_ORDER
  SELF_ORDER
  TAKEAWAY
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  OTHER
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

model Branch {
  id            String       @id @default(uuid())
  name          String
  address       String
  city          String
  state         String
  country       String
  phone         String
  email         String
  openingTime   String
  closingTime   String
  weeklyHoliday String?
  status        BranchStatus @default(OPENING_SOON)

  managerId String?   @unique
  manager   Employee? @relation("BranchManager", fields: [managerId], references: [id])

  employees  Employee[]        @relation("BranchEmployees")
  categories Category[]
  items      Item[]
  tables     RestaurantTable[]
  coupons    Coupon[]
  orders     Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id           String    @id @default(uuid())
  fullName     String
  email        String?   @unique
  phone        String?   @unique
  loginId      String    @unique
  passwordHash String
  role         Role
  department   String?
  status       ActiveStatus @default(ACTIVE)
  joiningDate  DateTime  @default(now())

  branchId String?
  branch   Branch? @relation("BranchEmployees", fields: [branchId], references: [id])

  managesBranch Branch? @relation("BranchManager")

  permissions   EmployeePermission[]
  ordersTaken   Order[] @relation("ServiceEmployeeOrders")
  kitchenOrders Order[] @relation("KitchenEmployeeOrders")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String               @id @default(uuid())
  key         String               @unique
  employees   EmployeePermission[]
}

model EmployeePermission {
  id           String     @id @default(uuid())
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([employeeId, permissionId])
}

model Customer {
  id        String     @id @default(uuid())
  fullName  String?
  email     String?    @unique
  phone     String?    @unique
  createdAt DateTime   @default(now())

  orders  Order[]
  reviews Review[]
  otps    OtpCode[]
}

model OtpCode {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  codeHash   String
  channel    String
  expiresAt  DateTime
  attempts   Int      @default(0)
  consumed   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model Category {
  id          String       @id @default(uuid())
  name        String
  description String?
  image       String?
  status      ActiveStatus @default(ACTIVE)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  items Item[]

  @@unique([branchId, name])
}

model Item {
  id              String       @id @default(uuid())
  name            String
  description     String?
  price           Decimal
  discount        Decimal      @default(0)
  ingredients     String?
  preparationTime Int?
  status          ActiveStatus @default(ACTIVE)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  images     ItemImage[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ItemImage {
  id        String  @id @default(uuid())
  itemId    String
  item      Item    @relation(fields: [itemId], references: [id])
  url       String
  isPrimary Boolean @default(false)
}

model RestaurantTable {
  id       String      @id @default(uuid())
  number   Int
  capacity Int
  status   TableStatus @default(AVAILABLE)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  sessions TableSession[]

  @@unique([branchId, number])
}

model TableSession {
  id       String        @id @default(uuid())
  status   SessionStatus @default(OPEN)
  openedAt DateTime      @default(now())
  closedAt DateTime?

  tableId String
  table   RestaurantTable @relation(fields: [tableId], references: [id])

  orders Order[]
  bills  Bill[]
}

model Order {
  id                  String      @id @default(uuid())
  orderNumber         Int         @default(autoincrement())
  type                OrderType
  status              OrderStatus @default(PENDING)
  specialInstructions String?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  tableSessionId String?
  tableSession   TableSession? @relation(fields: [tableSessionId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  serviceEmployeeId String?
  serviceEmployee   Employee? @relation("ServiceEmployeeOrders", fields: [serviceEmployeeId], references: [id])

  kitchenEmployeeId String?
  kitchenEmployee   Employee? @relation("KitchenEmployeeOrders", fields: [kitchenEmployeeId], references: [id])

  couponId       String?
  coupon         Coupon? @relation(fields: [couponId], references: [id])

  subtotal       Decimal @default(0)
  discountAmount Decimal @default(0)
  taxAmount      Decimal @default(0)
  total          Decimal @default(0)

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  billItems     BillItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id            String  @id @default(uuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id])
  itemId        String
  item          Item    @relation(fields: [itemId], references: [id])
  nameSnapshot  String
  priceSnapshot Decimal
  quantity      Int
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  status    OrderStatus
  changedBy String?
  changedAt DateTime    @default(now())
}

model Coupon {
  id               String       @id @default(uuid())
  code             String       @unique
  description      String?
  discountType     DiscountType
  discountValue    Decimal
  minOrder         Decimal      @default(0)
  maxDiscount      Decimal?
  startDate        DateTime
  expiryDate       DateTime
  usageLimit       Int?
  perCustomerLimit Int?
  status           ActiveStatus @default(ACTIVE)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  usages CouponUsage[]
  orders Order[]
}

model CouponUsage {
  id         String   @id @default(uuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id])
  customerId String?
  usedAt     DateTime @default(now())
}

model Bill {
  id            String        @id @default(uuid())
  billNumber    Int           @default(autoincrement())
  subtotal      Decimal
  discount      Decimal       @default(0)
  tax           Decimal       @default(0)
  total         Decimal
  paymentStatus PaymentStatus @default(UNPAID)
  generatedById String?

  tableSessionId String?
  tableSession   TableSession? @relation(fields: [tableSessionId], references: [id])

  items    BillItem[]
  payments Payment[]

  createdAt DateTime @default(now())
}

model BillItem {
  id      String @id @default(uuid())
  billId  String
  bill    Bill   @relation(fields: [billId], references: [id])
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])
}

model Payment {
  id           String        @id @default(uuid())
  billId       String
  bill         Bill          @relation(fields: [billId], references: [id])
  amount       Decimal
  method       PaymentMethod
  recordedById String?
  recordedAt   DateTime      @default(now())
}

model Review {
  id               String   @id @default(uuid())
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id])
  orderId          String?
  itemRating       Int?
  restaurantRating Int?
  text             String?
  approved         Boolean  @default(true)
  createdAt        DateTime @default(now())
}

model Notification {
  id            String   @id @default(uuid())
  userId        String
  userType      String
  type          String
  title         String
  message       String
  relatedEntity String?
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId, userType])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userRole  String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
}
